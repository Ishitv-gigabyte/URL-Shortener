# Used by the Spring Boot service (see src/main/resources/application.yml for defaults).
DB_PRIMARY_URL=jdbc:postgresql://localhost:5432/urlshortener
# Optional; defaults to DB_PRIMARY_URL. Point at an RDS read replica in production.
DB_REPLICA_URL=
DB_USERNAME=postgres
